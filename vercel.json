{
    "version": 2,
    "buildCommand": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [{
        "source": "/(.*)",
        "destination": "/index.js"
    }],
    "functions": {
        "index.js": {
            "includeFiles": "dist/**"
        }
    },
    "env": {
        "NODE_ENV": "production"
    }
}